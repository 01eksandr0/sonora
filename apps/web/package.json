    "@tanstack/vue-query": "5.103.1",
    "@vueuse/core": "15.0.0",
    "pinia": "4.0.3",
    "primeicons": "8.0.1",
    "primevue": "5.0.1",
    "vee-validate": "4.15.1",
    "vue": "3.5.43",
