// Prisma schema. Models are added in Phase 4 (after the Catalog domain is designed).
// Database URL lives in prisma.config.ts (Prisma 7 style), not here.

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
  runtime      = "nodejs"
}

datasource db {
  provider = "postgresql"
}

enum MusicProvider {
  DEEZER
}

enum TasteSignalSource {
  ONBOARDING
  LIKE
  LISTEN
  SKIP
  MANUAL
}

model User {
  id                  String        @id @default(uuid())
  email               String        @unique
  passwordHash        String        @map("password_hash")
  onboardingCompleted Boolean       @default(false) @map("onboarding_completed")
  createdAt           DateTime      @default(now()) @map("created_at")
  updatedAt           DateTime      @updatedAt @map("updated_at")

  profile             UserProfile?
  tasteProfile        TasteProfile?

  @@map("users")
}

model UserProfile {
  id          String    @id @default(uuid())
  userId      String    @unique @map("user_id")
  displayName String?   @map("display_name")
  avatarUrl   String?   @map("avatar_url")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_profiles")
}

model TasteProfile {
  id        String   @id @default(uuid())
  userId    String   @unique @map("user_id")
  moods     String[] @default([])
  languages String[] @default([])
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user    User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  genres  TasteGenrePreference[]
  artists TasteArtistPreference[]

  @@map("taste_profiles")
}

model TasteGenrePreference {
  id        String            @id @default(uuid())
  profileId String            @map("profile_id")
  genre     String
  weight    Float             @default(1.0)
  source    TasteSignalSource @default(ONBOARDING)
  createdAt DateTime          @default(now()) @map("created_at")

  profile TasteProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@unique([profileId, genre])
  @@map("taste_genre_preferences")
}

model TasteArtistPreference {
  id         String            @id @default(uuid())
  profileId  String            @map("profile_id")
  artistName String            @map("artist_name")
  weight     Float             @default(1.0)
  source     TasteSignalSource @default(ONBOARDING)
  createdAt  DateTime          @default(now()) @map("created_at")

  profile TasteProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@unique([profileId, artistName])
  @@map("taste_artist_preferences")
}

model Artist {
  id         String        @id @default(uuid())
  provider   MusicProvider @default(DEEZER)
  providerId String        @map("provider_id")
  name       String
  images     Json?         @default("{}")
  createdAt  DateTime      @default(now()) @map("created_at")
  updatedAt  DateTime      @updatedAt @map("updated_at")

  tracks     Track[]
  albums     Album[]

  @@unique([provider, providerId])
  @@map("artists")
}

model Album {
  id          String        @id @default(uuid())
  provider    MusicProvider @default(DEEZER)
  providerId  String        @map("provider_id")
  title       String
  artistId    String        @map("artist_id")
  cover       Json?         @default("{}")
  releaseDate DateTime?     @map("release_date")
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  artist      Artist        @relation(fields: [artistId], references: [id], onDelete: Cascade)
  tracks      Track[]

  @@unique([provider, providerId])
  @@map("albums")
}

model Track {
  id           String        @id @default(uuid())
  provider     MusicProvider @default(DEEZER)
  providerId   String        @map("provider_id")
  title        String
  titleVersion String?       @map("title_version")
  duration     Int
  previewUrl   String?       @map("preview_url")
  explicit     Boolean       @default(false)
  artistId     String        @map("artist_id")
  albumId      String        @map("album_id")
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")

  artist       Artist        @relation(fields: [artistId], references: [id], onDelete: Cascade)
  album        Album         @relation(fields: [albumId], references: [id], onDelete: Cascade)

  @@unique([provider, providerId])
  @@map("tracks")
}

model Genre {
  id         String        @id @default(uuid())
  provider   MusicProvider @default(DEEZER)
  providerId String        @map("provider_id")
  name       String
  images     Json?         @default("{}")
  createdAt  DateTime      @default(now()) @map("created_at")
  updatedAt  DateTime      @updatedAt @map("updated_at")

  @@unique([provider, providerId])
  @@map("genres")
}
